{
  "$defs": {
    "Benchmarks": {
      "additionalProperties": false,
      "properties": {
        "seed": {
          "default": 42,
          "title": "Seed",
          "type": "integer"
        },
        "repetitions": {
          "default": 3,
          "maximum": 100,
          "minimum": 1,
          "title": "Repetitions",
          "type": "integer"
        },
        "concurrency": {
          "const": 1,
          "default": 1,
          "title": "Concurrency",
          "type": "integer"
        },
        "run_root": {
          "default": ".prism/runs",
          "title": "Run Root",
          "type": "string"
        }
      },
      "title": "Benchmarks",
      "type": "object"
    },
    "Controller": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "default": "jev_cpu",
          "enum": [
            "jev_cpu",
            "rules"
          ],
          "title": "Backend",
          "type": "string"
        },
        "model_source": {
          "default": "Qwen/Qwen3-0.6B",
          "minLength": 1,
          "title": "Model Source",
          "type": "string"
        },
        "artifact_ref": {
          "default": "quick",
          "minLength": 1,
          "title": "Artifact Ref",
          "type": "string"
        },
        "device": {
          "const": "cpu",
          "default": "cpu",
          "title": "Device",
          "type": "string"
        },
        "dtype": {
          "const": "float32",
          "default": "float32",
          "title": "Dtype",
          "type": "string"
        },
        "scoring_mode": {
          "default": "direct",
          "enum": [
            "direct",
            "shared",
            "compact_generation"
          ],
          "title": "Scoring Mode",
          "type": "string"
        },
        "max_input_tokens": {
          "default": 1024,
          "exclusiveMinimum": 0,
          "title": "Max Input Tokens",
          "type": "integer"
        },
        "max_request_bytes": {
          "default": 262144,
          "exclusiveMinimum": 0,
          "title": "Max Request Bytes",
          "type": "integer"
        },
        "max_criterion_bytes": {
          "default": 32768,
          "exclusiveMinimum": 0,
          "title": "Max Criterion Bytes",
          "type": "integer"
        },
        "max_criteria_per_batch": {
          "default": 8,
          "exclusiveMinimum": 0,
          "title": "Max Criteria Per Batch",
          "type": "integer"
        },
        "max_padded_suffix_tokens": {
          "default": 8192,
          "exclusiveMinimum": 0,
          "title": "Max Padded Suffix Tokens",
          "type": "integer"
        },
        "process_mode": {
          "const": "spawned",
          "default": "spawned",
          "title": "Process Mode",
          "type": "string"
        },
        "threads": {
          "default": 2,
          "maximum": 64,
          "minimum": 1,
          "title": "Threads",
          "type": "integer"
        },
        "interop_threads": {
          "default": 1,
          "maximum": 16,
          "minimum": 1,
          "title": "Interop Threads",
          "type": "integer"
        },
        "max_inflight_batches": {
          "const": 1,
          "default": 1,
          "title": "Max Inflight Batches",
          "type": "integer"
        },
        "queue_capacity": {
          "default": 8,
          "maximum": 1024,
          "minimum": 0,
          "title": "Queue Capacity",
          "type": "integer"
        },
        "inference_timeout_ms": {
          "default": 10000,
          "exclusiveMinimum": 0,
          "title": "Inference Timeout Ms",
          "type": "integer"
        },
        "startup_timeout_ms": {
          "default": 120000,
          "exclusiveMinimum": 0,
          "title": "Startup Timeout Ms",
          "type": "integer"
        },
        "max_restarts": {
          "default": 1,
          "maximum": 3,
          "minimum": 0,
          "title": "Max Restarts",
          "type": "integer"
        },
        "on_unavailable": {
          "default": "abstain",
          "enum": [
            "abstain",
            "error"
          ],
          "title": "On Unavailable",
          "type": "string"
        }
      },
      "title": "Controller",
      "type": "object"
    },
    "Files": {
      "additionalProperties": false,
      "properties": {
        "policy_config": {
          "default": "multicall.yaml",
          "title": "Policy Config",
          "type": "string"
        },
        "litellm_config": {
          "default": "litellm.yaml",
          "title": "Litellm Config",
          "type": "string"
        },
        "artifact_lock": {
          "default": ".prism/artifacts.lock.json",
          "title": "Artifact Lock",
          "type": "string"
        }
      },
      "title": "Files",
      "type": "object"
    },
    "Measurements": {
      "additionalProperties": false,
      "properties": {
        "sample_interval_ms": {
          "default": 250,
          "exclusiveMinimum": 0,
          "title": "Sample Interval Ms",
          "type": "integer"
        },
        "log_content": {
          "default": false,
          "title": "Log Content",
          "type": "boolean"
        },
        "collect_gpu": {
          "default": "auto",
          "enum": [
            "auto",
            "disabled"
          ],
          "title": "Collect Gpu",
          "type": "string"
        },
        "collect_energy": {
          "default": "auto",
          "enum": [
            "auto",
            "disabled"
          ],
          "title": "Collect Energy",
          "type": "string"
        }
      },
      "title": "Measurements",
      "type": "object"
    },
    "Privacy": {
      "additionalProperties": false,
      "properties": {
        "local_only": {
          "const": true,
          "default": true,
          "title": "Local Only",
          "type": "boolean"
        },
        "log_content": {
          "default": false,
          "title": "Log Content",
          "type": "boolean"
        }
      },
      "title": "Privacy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "prism_project",
      "default": "prism_project",
      "title": "Kind",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "workdir": {
      "default": ".",
      "title": "Workdir",
      "type": "string"
    },
    "files": {
      "$ref": "#/$defs/Files"
    },
    "privacy": {
      "$ref": "#/$defs/Privacy"
    },
    "controllers": {
      "additionalProperties": {
        "$ref": "#/$defs/Controller"
      },
      "propertyNames": {
        "minLength": 1
      },
      "title": "Controllers",
      "type": "object"
    },
    "measurements": {
      "$ref": "#/$defs/Measurements"
    },
    "benchmarks": {
      "$ref": "#/$defs/Benchmarks"
    }
  },
  "title": "ProjectConfig",
  "type": "object"
}
