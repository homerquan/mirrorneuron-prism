{
  "$defs": {
    "APISettings": {
      "additionalProperties": false,
      "properties": {
        "unsupported": {
          "default": "reject",
          "enum": [
            "reject",
            "passthrough"
          ],
          "title": "Unsupported",
          "type": "string"
        },
        "passthrough_model": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Passthrough Model"
        }
      },
      "title": "APISettings",
      "type": "object"
    },
    "Adaptive": {
      "additionalProperties": false,
      "properties": {
        "initial_samples": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Initial Samples",
          "type": "integer"
        },
        "expansion_batches": {
          "items": {
            "exclusiveMinimum": 0,
            "type": "integer"
          },
          "title": "Expansion Batches",
          "type": "array"
        },
        "early_stop": {
          "const": "semantic_verifier_pass",
          "default": "semantic_verifier_pass",
          "title": "Early Stop",
          "type": "string"
        }
      },
      "title": "Adaptive",
      "type": "object"
    },
    "Budgets": {
      "additionalProperties": false,
      "properties": {
        "max_model_calls": {
          "exclusiveMinimum": 0,
          "title": "Max Model Calls",
          "type": "integer"
        },
        "max_backend_attempts": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Backend Attempts"
        },
        "max_total_tokens": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Total Tokens"
        },
        "deadline_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deadline Ms"
        },
        "child_timeout_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Child Timeout Ms"
        }
      },
      "required": [
        "max_model_calls"
      ],
      "title": "Budgets",
      "type": "object"
    },
    "CandidateConfig": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "max_completion_tokens": {
          "default": 1500,
          "exclusiveMinimum": 0,
          "title": "Max Completion Tokens",
          "type": "integer"
        },
        "temperature": {
          "default": 0,
          "maximum": 2,
          "minimum": 0,
          "title": "Temperature",
          "type": "number"
        },
        "samples": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Samples",
          "type": "integer"
        },
        "prompt_variants": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Prompt Variants",
          "type": "array"
        }
      },
      "required": [
        "model"
      ],
      "title": "CandidateConfig",
      "type": "object"
    },
    "Combine": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "prompt": {
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        }
      },
      "required": [
        "model",
        "prompt"
      ],
      "title": "Combine",
      "type": "object"
    },
    "Decompose": {
      "additionalProperties": false,
      "properties": {
        "planner_model": {
          "minLength": 1,
          "title": "Planner Model",
          "type": "string"
        },
        "executor_model": {
          "minLength": 1,
          "title": "Executor Model",
          "type": "string"
        },
        "min_subjobs": {
          "exclusiveMinimum": 0,
          "title": "Min Subjobs",
          "type": "integer"
        },
        "max_subjobs": {
          "exclusiveMinimum": 0,
          "title": "Max Subjobs",
          "type": "integer"
        },
        "decomposition_prompt": {
          "minLength": 1,
          "title": "Decomposition Prompt",
          "type": "string"
        }
      },
      "required": [
        "planner_model",
        "executor_model",
        "min_subjobs",
        "max_subjobs",
        "decomposition_prompt"
      ],
      "title": "Decompose",
      "type": "object"
    },
    "Execution": {
      "additionalProperties": false,
      "properties": {
        "concurrency": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Concurrency",
          "type": "integer"
        },
        "max_retries": {
          "default": 0,
          "minimum": 0,
          "title": "Max Retries",
          "type": "integer"
        }
      },
      "title": "Execution",
      "type": "object"
    },
    "Generation": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "max_completion_tokens": {
          "default": 1500,
          "exclusiveMinimum": 0,
          "title": "Max Completion Tokens",
          "type": "integer"
        },
        "temperature": {
          "default": 0,
          "maximum": 2,
          "minimum": 0,
          "title": "Temperature",
          "type": "number"
        }
      },
      "required": [
        "model"
      ],
      "title": "Generation",
      "type": "object"
    },
    "Policy": {
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "enum": [
            "best_of_n",
            "adaptive",
            "decompose_map_reduce"
          ],
          "title": "Strategy",
          "type": "string"
        },
        "allowed_model_groups": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Allowed Model Groups",
          "type": "array"
        },
        "privacy": {
          "default": "local_only",
          "enum": [
            "local_only",
            "allow_cloud"
          ],
          "title": "Privacy",
          "type": "string"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/CandidateConfig"
          },
          "title": "Candidates",
          "type": "array"
        },
        "selection": {
          "anyOf": [
            {
              "$ref": "#/$defs/Selection"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "adaptive": {
          "anyOf": [
            {
              "$ref": "#/$defs/Adaptive"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "decompose": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decompose"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "execution": {
          "anyOf": [
            {
              "$ref": "#/$defs/Execution"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "combine": {
          "anyOf": [
            {
              "$ref": "#/$defs/Combine"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fallback": {
          "anyOf": [
            {
              "$ref": "#/$defs/Generation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "budgets": {
          "$ref": "#/$defs/Budgets"
        },
        "on_unresolved": {
          "default": "error",
          "enum": [
            "error",
            "fallback"
          ],
          "title": "On Unresolved",
          "type": "string"
        },
        "api": {
          "$ref": "#/$defs/APISettings"
        }
      },
      "required": [
        "strategy",
        "allowed_model_groups",
        "budgets"
      ],
      "title": "Policy",
      "type": "object"
    },
    "Runtime": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "const": "proxy_router",
          "default": "proxy_router",
          "title": "Backend",
          "type": "string"
        },
        "integration_profile": {
          "default": "trusted_local",
          "enum": [
            "trusted_local",
            "authenticated_proxy"
          ],
          "title": "Integration Profile",
          "type": "string"
        },
        "max_inflight_children_per_worker": {
          "default": 4,
          "exclusiveMinimum": 0,
          "title": "Max Inflight Children Per Worker",
          "type": "integer"
        },
        "max_inflight_children_per_request": {
          "default": 2,
          "exclusiveMinimum": 0,
          "title": "Max Inflight Children Per Request",
          "type": "integer"
        },
        "child_cache": {
          "const": "disabled",
          "default": "disabled",
          "title": "Child Cache",
          "type": "string"
        },
        "outer_cache": {
          "const": "disabled",
          "default": "disabled",
          "title": "Outer Cache",
          "type": "string"
        },
        "log_content": {
          "default": false,
          "title": "Log Content",
          "type": "boolean"
        }
      },
      "title": "Runtime",
      "type": "object"
    },
    "Selection": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "max_completion_tokens": {
          "default": 1500,
          "exclusiveMinimum": 0,
          "title": "Max Completion Tokens",
          "type": "integer"
        },
        "temperature": {
          "default": 0,
          "maximum": 2,
          "minimum": 0,
          "title": "Temperature",
          "type": "number"
        },
        "type": {
          "const": "llm_judge",
          "default": "llm_judge",
          "title": "Type",
          "type": "string"
        },
        "allow_abstain": {
          "default": true,
          "title": "Allow Abstain",
          "type": "boolean"
        }
      },
      "required": [
        "model"
      ],
      "title": "Selection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "title": "Schema Version",
      "type": "integer"
    },
    "runtime": {
      "$ref": "#/$defs/Runtime"
    },
    "policies": {
      "additionalProperties": {
        "$ref": "#/$defs/Policy"
      },
      "minProperties": 1,
      "propertyNames": {
        "minLength": 1
      },
      "title": "Policies",
      "type": "object"
    },
    "prompt_variants": {
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "minLength": 1
      },
      "title": "Prompt Variants",
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "policies"
  ],
  "title": "PrismConfig",
  "type": "object"
}
